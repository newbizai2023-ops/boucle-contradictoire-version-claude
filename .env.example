PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@localhost:5432/boucle
# En production (NODE_ENV=production), la connexion Postgres vérifie le certificat TLS par
# défaut. Ne passer DATABASE_SSL_REJECT_UNAUTHORIZED=false que si l'autorité de certification
# n'est pas disponible et que le risque d'interception réseau est accepté explicitement.
# Alternative recommandée : fournir DATABASE_CA_CERT (certificat PEM) pour une vérification
# stricte avec une autorité privée.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA_CERT=
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
# Ne passer à true que si l'option « Zero Data Retention » est explicitement activée sur le compte
# Firecrawl (fonctionnalité à demander à support@firecrawl.com) : sinon, Firecrawl rejette TOUTES
# les requêtes avec une erreur HTTP 403, faisant apparaître chaque source comme « inaccessible ».
FIRECRAWL_ZERO_DATA_RETENTION=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ne JAMAIS activer en production (NODE_ENV=production) : le serveur refuse de démarrer si
# les deux sont combinés, car cela contournerait totalement l'authentification Google.
DEV_BYPASS_AUTH=false
